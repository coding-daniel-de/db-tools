# Globale Konfiguration für alle db-tools-Skripte (export und import).
# Kopieren nach dbtools.conf und bei Bedarf anpassen:
#   cp dbtools.conf.example dbtools.conf
#
# Fehlt dbtools.conf, werden $HOME/sql-dumps und $HOME/sql-patches als Standard verwendet
# (DDEV-Exporte landen dann ebenfalls in $HOME/sql-dumps).
# Relative Pfade gelten relativ zum Ordner der Skripte.
# Die Datei wird geschichtet geladen (Root, conf/, ~/db-tools-conf/; spätere Werte gewinnen einzeln).

# Verzeichnis für SQL-Dumps. Tilde (~) wird von Bash in Anführungszeichen
# NICHT aufgelöst, stattdessen $HOME verwenden, z. B.:
#   DUMP_DIR="$HOME/sql-dumps"
DUMP_DIR="$HOME/sql-dumps"

# Verzeichnis für Patch-Dateien, die importDB.sh mit "--patch" (ohne Dateiname) zur Auswahl anzeigt
PATCH_DIR="$HOME/sql-patches"

# Verzeichnis für DDEV-Exporte (exportDB.sh ddev). Leer oder nicht gesetzt: wie DUMP_DIR.
#   DDEV_DUMP_DIR="$HOME/work/docker/00_dumps"
DDEV_DUMP_DIR=""

# Für backupAll.sh (Cron): Umgebungen, die gesichert werden (Namen der db_<name>.conf,
# durch Leerzeichen getrennt) und der Zielordner. Ohne BACKUP_DIR gilt DUMP_DIR.
#   BACKUP_ENVS="live dev kunde2"
#   BACKUP_DIR="$HOME/backups"
BACKUP_ENVS=""
BACKUP_DIR=""

# Rechte-Warnung: haben Gruppe oder andere irgendein Recht an einer db_<name>.conf (alles außer
# 600/400), meldet jedes Tool beim Laden eine Warnung auf stderr (Lauf geht weiter). 0 schaltet ab.
CHECK_CONF_PERMS=1
